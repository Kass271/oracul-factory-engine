{
  "_doc": "What each step must leave on disk. Paths are relative to the app; {phase} and {slice} are substituted. 04_build items carry a stage: spec < red < review < done; 'blocked' replaces 'done' for BLOCKED slices. 'spec' items are checked only for an explicit --slice.",
  "00_setup": [
    { "path": "docs/{phase}/00_setup/adr-001-stack.md", "rule": "contains:Spring Boot" },
    { "path": "docs/{phase}/00_setup/environment-check.md", "rule": "contains:Result: OK" },
    { "path": "api/openapi.yaml", "rule": "openapi" },
    { "path": "docker-compose.yml", "rule": "contains:services:" },
    { "path": "backend/build.gradle.kts", "rule": "contains:openApiGenerate" },
    { "path": "frontend/package.json", "rule": "contains:@angular/material" },
    { "path": "e2e/playwright.config.ts", "rule": "nonEmpty" }
  ],
  "01_scope": [
    { "path": "docs/{phase}/01_scope/idea.md", "rule": "nonEmpty" },
    { "path": "docs/{phase}/01_scope/clarification-log.md", "rule": "regex:^##\\s*Round\\s+\\d+" },
    { "path": "docs/{phase}/01_scope/requirements.md", "rule": "requirements" },
    { "path": "docs/{phase}/01_scope/requirements.md", "rule": "approved" }
  ],
  "02_specs": [
    { "path": "docs/{phase}/02_specs/*.md", "rule": "minFiles:2" },
    { "path": "docs/{phase}/02_specs/contract-notes.md", "rule": "nonEmpty" },
    { "path": "docs/{phase}/02_specs", "rule": "specsCoverFrs" },
    { "path": "api/openapi.yaml", "rule": "openapi" }
  ],
  "03_plan": [
    { "path": "docs/{phase}/03_plan/plan.md", "rule": "planCoversFrs" },
    { "path": "docs/{phase}/03_plan/plan.md", "rule": "approved" }
  ],
  "04_build": [
    { "path": "docs/{phase}/02_specs", "rule": "sliceSpec", "stage": "spec" },
    { "path": "docs/{phase}/04_build/{slice}/red-evidence.md", "rule": "contains:RESULT: RED", "stage": "red" },
    { "path": "docs/{phase}/04_build/{slice}/review-findings.json", "rule": "reviewFile", "stage": "review" },
    { "path": "docs/{phase}/04_build/{slice}/review-findings.json", "rule": "reviewClean", "stage": "done" },
    { "path": "docs/{phase}/04_build/{slice}/rounds.md", "rule": "nonEmpty", "stage": "done", "onlyIfRounds": true },
    { "path": "docs/{phase}/04_build/{slice}/failure-note.md", "rule": "regex:^## What failed", "stage": "blocked" },
    { "path": "docs/{phase}/04_build/{slice}/rounds.md", "rule": "nonEmpty", "stage": "blocked" }
  ],
  "05_release": [
    { "path": "docs/{phase}/05_release/review-findings.json", "rule": "reviewClean" },
    { "path": "e2e/report/results.json", "rule": "playwrightGreen" },
    { "path": "docs/{phase}/05_release/qa/traceability.md", "rule": "mentionsEveryFr" },
    { "path": "docs/{phase}/05_release/qa/traceability.md", "rule": "contains:Generated by gen-traceability" },
    { "path": "docs/{phase}/05_release/qa/test-plan.md", "rule": "mentionsPhaseFrs" },
    { "path": "docs/{phase}/05_release/qa/acceptance-report.md", "rule": "mentionsPhaseFrs" },
    { "path": "docs/{phase}/05_release/qa/acceptance-report.md", "rule": "evidenceLinks" },
    { "path": "docs/{phase}/05_release/qa/how-to-run.md", "rule": "contains:docker compose" },
    { "path": "docs/{phase}/05_release/qa/screenshots", "rule": "screenshotPerUiFr" },
    { "path": "backend/src/main", "rule": "noSyncMarkers" }
  ]
}
